# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Simli (server-only: never prefix these with NEXT_PUBLIC_) ---
# API key from https://app.simli.com. Used only by app/api/simli-token/route.ts.
SIMLI_API_KEY=
# Avatar face ID. Defaults to the Trinity-2 preset "Anna" if left empty.
SIMLI_FACE_ID=bf13113a-355a-4d97-8b90-4edccd1da7b2

# Production builds (NODE_ENV=production) refuse to mint Simli tokens until you
# add auth/rate limiting to app/api/simli-token/route.ts. Set this to "true" only
# to knowingly run a public, unauthenticated deployment (anyone can spend your minutes).
ALLOW_UNAUTHENTICATED_SESSIONS=false

# --- Vapi (browser) ---
# Your Vapi PUBLIC key (Dashboard -> API Keys -> Public). It is designed to be
# exposed in browser code, so treat it as public: anyone can copy it and start
# calls. Allowed-origin/assistant restrictions help but are not a security
# boundary (see README). NEVER put your Vapi PRIVATE key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# The assistant to talk to (Dashboard -> Assistants -> copy the ID).
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
