# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Simli (server-only: never prefix these with NEXT_PUBLIC_) ---
# API key from https://app.simli.com. Used only by app/api/simli-token/route.ts.
SIMLI_API_KEY=
# Avatar face ID. Defaults to the Trinity-2 preset "Anna" if left empty.
SIMLI_FACE_ID=bf13113a-355a-4d97-8b90-4edccd1da7b2

# --- Vapi (browser) ---
# Your Vapi PUBLIC key (Dashboard -> API Keys -> Public). It is designed to be
# exposed in browser code; restrict its allowed origins and assistants in the
# Vapi dashboard. NEVER put your Vapi PRIVATE key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# The assistant to talk to (Dashboard -> Assistants -> copy the ID).
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
